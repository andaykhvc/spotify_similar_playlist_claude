# developer.spotify.com/dashboard → Create app → Web API.
# Add the redirect URI below exactly (Spotify rejects "localhost"; use 127.0.0.1).
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Any random string of 32+ chars, e.g. `openssl rand -base64 32`
SESSION_SECRET=
